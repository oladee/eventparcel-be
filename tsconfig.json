{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "moduleResolution": "node",
        "rootDir": "src",
        "baseUrl": ".",
        "outDir": "dist",
        "sourceMap": true,
        "noImplicitAny": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "typeRoots": ["./node_modules/@types"],
        "types": ["node"],
        "paths": {
            "hyperwallet-sdk": ["src/@types/hyperwallet-sdk"]
        }
    },
    "include": ["src/**/*", "src/@types/**/*.d.ts"],
    "exclude": ["node_modules"]
}
